{
  "id": "quantize_bench",
  "order": 3,
  "difficulty": "basic",
  "tags": [
    "quantize",
    "eval"
  ],
  "sample_data": false,
  "requires_hf_account": false,
  "workflow": {
    "format": "vlm-workflow",
    "schema_version": 1,
    "name": "quantize_bench",
    "nodes": [
      {
        "id": "n1",
        "type": "model.hf_pick",
        "version": "1.0.0",
        "params": {
          "model": "nemotron-parse-v1.1"
        }
      },
      {
        "id": "n2",
        "type": "data.hf_load",
        "version": "1.0.0",
        "params": {
          "repo": "naver-clova-ix/cord-v2"
        }
      },
      {
        "id": "n3",
        "type": "quantize.modelopt_ptq",
        "version": "1.0.0",
        "params": {
          "format": "fp8"
        }
      },
      {
        "id": "n4",
        "type": "eval.benchmarks",
        "version": "1.0.0",
        "params": {
          "suite": "cord_test"
        }
      }
    ],
    "edges": [
      {
        "from": [
          "n1",
          "model"
        ],
        "to": [
          "n3",
          "model"
        ]
      },
      {
        "from": [
          "n2",
          "dataset"
        ],
        "to": [
          "n3",
          "calib_data"
        ]
      },
      {
        "from": [
          "n3",
          "quantized"
        ],
        "to": [
          "n4",
          "model"
        ]
      },
      {
        "from": [
          "n2",
          "dataset"
        ],
        "to": [
          "n4",
          "data"
        ]
      }
    ]
  },
  "title_key": "template.quantize_bench.title",
  "description_key": "template.quantize_bench.desc"
}
