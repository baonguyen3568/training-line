+def param_matches_prefix(name: str, prefix: str) -> bool:
+    """PATCH(vlm): True when ``prefix`` (``model.visual.merger``) appears as a run of whole module names anywhere in
+    ``name`` (so wrappers like ``_orig_mod.`` still match, ``model.visual.merger2`` does not). A short prefix such as
+    ``merger`` therefore matches every submodule of that name: give the full dotted path."""
+    prefix = prefix.rstrip(".")
+    return f".{name}".find(f".{prefix}.") >= 0 or f".{name}".endswith(f".{prefix}")
+
+
+def freeze_non_lora_params(model, freeze_config=None):
+    """PATCH(vlm): the PEFT freeze (every non-LoRA parameter) minus ``freeze_config.train_prefixes``, so a block trained
+    in full next to LoRA (two-stage stage 2: projector + LoRA) stays trainable. Matched by identity over every name
+    (``remove_duplicate=False``): a tied lm_head is listed under ``embed_tokens`` too."""
+    prefixes = tuple((freeze_config or {}).get("train_prefixes") or ())
+    keep = {
+        id(param)
+        for name, param in model.named_parameters(remove_duplicate=False)
+        if any(param_matches_prefix(name, p) for p in prefixes)
+    }
+    for name, param in model.named_parameters():
+        if id(param) not in keep and "lora_" not in name and param.requires_grad:
+            param.requires_grad_(False)
+
+
