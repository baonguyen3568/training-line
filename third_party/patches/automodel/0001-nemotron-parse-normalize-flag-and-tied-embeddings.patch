+def _resolve_processor_normalizes(get) -> bool:
+    # PATCH(vlm): the encoder flag is `image_processor_normalizes` up to Parse v1.1 and `processor_normalizes` from
+    # v1.2 on. Accept both (new name wins) and warn if they disagree; `get(name)` returns None when absent.
+    new, old = get("processor_normalizes"), get("image_processor_normalizes")
+    if new is not None and old is not None and bool(new) != bool(old):
+        logger.warning(
+            "encoder processor_normalizes=%s and image_processor_normalizes=%s disagree; using processor_normalizes",
+            new,
+            old,
+        )
+    return bool(new if new is not None else (old if old is not None else False))
+
