+# PATCH(vlm): the streaming path skipped what HF's own BnB loader never quantizes. HF adds get_keys_to_not_convert
+# (tied weights, the output embeddings, the last module) to the skip list; this path used only llm_int8_skip_modules or
+# _keep_in_fp32_modules, so a TIED lm_head (Qwen3.5, tie_word_embeddings) became Linear4bit and tie_weights() then gave
+# it the bf16 embedding: AssertionError in fix_4bit_weight_quant_state_from_module at the first step. A tied output
+# embedding can never be 4-bit (its weight IS the embedding), so the defaults are always added, recipe skips on top.
+def bnb_modules_to_not_convert(model, quantization_config):  # PATCH(vlm)
+    from transformers.quantizers.base import get_keys_to_not_convert
+
+    skip = list(getattr(quantization_config, "llm_int8_skip_modules", None) or [])
+    skip += list(getattr(model, "_keep_in_fp32_modules", None) or [])
+    skip += get_keys_to_not_convert(model)
+    return sorted(set(skip))
+
+
