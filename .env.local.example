# NTC-Training: copy to .env.local at the project root (gitignored), then: chmod 600 .env.local
# The ONE place for infrastructure settings (ADR-015). User settings live in the app (Cài đặt), admin policy in
# ~/.config/ntc-training/policy.toml. Never commit .env.local, never zip/share the project folder while it exists.

# --- infrastructure (read by the app; only these keys are ever read by it) ---
VLM_PORT=7870
# Absolute path for .cache/ outputs/ data/ uploads/ (default: the project folder)
# VLM_DATA_ROOT=/srv/ntc-training
# GPU lock (set by scripts/install.sh, not here): the project's .team/lock when it exists (a team machine: the app,
# the runner and host scripts share ONE lock), else <VLM_DATA_ROOT>/system/lock (a user install).
# personal | shared_dev. If the admin policy sets [deployment] profile, that wins and this may only tighten it.
VLM_PROFILE=shared_dev
# Set by docker compose (jobs go through the vlm-runner sidecar)
# VLM_RUNNER_SOCKET=/run/vlm-runner/runner.sock
# off | dry_run | apply. On shared_dev, apply needs [storage] schedule = "apply" in
# ~/.config/ntc-training/policy.toml; env may only lower it.
# VLM_RETENTION_SCHEDULE=dry_run

# --- secrets (compose `secrets:` only; the app never reads them, jobs never see this file) ---
# A READ-only Hugging Face token is enough for downloads.
HF_TOKEN=
NGC_API_KEY=
