---
import Marketing from "~/layouts/Marketing.astro";
import { productName } from "~/data/nav";
---

<Marketing title={productName} description="Fine-tune, nén và đánh giá model thị giác-ngôn ngữ bằng kéo thả, không cần viết code.">
  <section class="hero">
    <h1>{productName}</h1>
    <p>Khung trang chủ (M2-3). Nội dung và hiệu ứng làm sau khi user chọn hướng thiết kế (M2-1, M2-4).</p>
    <p><a href="/docs/bat-dau/">Đọc tài liệu</a></p>
  </section>
</Marketing>
