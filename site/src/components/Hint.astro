---
// "?" + popover for secondary explanations (M2: no filler text in the main flow).
// Stub: plain <details>, works without JS and under CSP; bao-design styles it later.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<details class="hint">
  <summary aria-label={title} title={title}>?</summary>
  <div class="hint-body" role="note">
    <strong>{title}</strong>
    <slot />
  </div>
</details>
