---
// NTC Training wordmark (D4): indigo tile with a geometric N, "NTC" bold + "Training" lighter. Never NVIDIA green.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<span class="wordmark" style={`--wm: ${size}px`}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="#6e56cf"></rect>
    <path d="M10.25 22.5V9.5l11.5 13V9.5" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="square"></path>
  </svg>
  <span class="wm-text"><b>NTC</b> <span>Training</span></span>
</span>
