# NTC-Training LAN edge (ADR-019, proposal 019). Rendered by scripts/install.sh into ~/.config/ntc-training/lan/;
# never edited by hand, never written by the app. Placeholders: @SERVER_NAMES@ @LAN_ALLOW@ @LAN_PORT@ (validated).
# The ONLY door from the LAN: TLS on 8443 (published on <LAN IP>:@LAN_PORT@ only), subnet allowlist, then the app,
# which applies its own sign-in. No HTTP/3 / QUIC (IMAGES.lock: 1.30.4 is fixed except for HTTP/3).
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    server_tokens off;
    default_type application/octet-stream;
    # Read-only root fs: every temp path on the /tmp tmpfs.
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;

    # $uri only: never the query string ($request_uri/$args), never a cookie or Authorization header.
    log_format edge '$remote_addr [$time_iso8601] "$request_method $uri" $status $body_bytes_sent '
                    '$request_time "$host"';
    access_log /dev/stdout edge;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
    # HSTS only for a host name: browsers ignore it for an IP literal.
    map $host $hsts {
        ~^[0-9.]+$ "";
        default    "max-age=31536000";
    }
    # Login attempts only (POST /api/session): 5/min per client IP. The page's own GET of /api/session is not limited.
    map $request_method $login_key {
        POST    $binary_remote_addr;
        default "";
    }
    limit_req_zone $login_key zone=login:1m rate=5r/m;
    limit_req_status 429;

    # Mozilla "intermediate" (2025): TLS 1.2 + 1.3. Private CA: no OCSP stapling. No session tickets.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:1m;
    ssl_session_timeout 1d;
    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    client_max_body_size 2m;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    proxy_http_version 1.1;
    proxy_redirect off;

    upstream app {
        server app:7870;
    }

    # Any Host that is not ours (DNS rebinding, scanners): close without a reply. Plain HTTP too.
    server {
        listen 8443 ssl default_server;
        server_name _;
        error_page 497 = @drop;
        location / {
            return 444;
        }
        location @drop {
            return 444;
        }
    }

    server {
        listen 8443 ssl;
        server_name @SERVER_NAMES@;

        # Docker bypasses the host firewall (UFW): this allowlist IS the firewall for the published port.
        allow @LAN_ALLOW@;
        deny all;

        # Plain HTTP on the TLS port: one redirect to HTTPS, no second port.
        error_page 497 =301 https://$host:@LAN_PORT@$request_uri;

        # The app decides LAN vs local from Host alone: always the matched name + our port, never the client's text.
        # Keep in step with the WebSocket location (proxy_set_header is not inherited by a location that sets one).
        proxy_set_header Host $host:@LAN_PORT@;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";

        # Edge headers replace the app's copies (no duplicates); the app's own CSP passes through (a second CSP
        # header only narrows it).
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header Strict-Transport-Security;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header Strict-Transport-Security $hsts always;

        location = /api/session {
            limit_req zone=login burst=5 nodelay;
            proxy_pass http://app;
        }

        location = /api/uploads {
            client_max_body_size 21m;  # the app's limit is 20 MB
            proxy_request_buffering off;  # streamed to the app, never spooled to disk here
            proxy_pass http://app;
        }

        # WebSockets: run and download events only. A location that sets any proxy_set_header inherits NONE from the
        # server block: Host and the X-Forwarded-* removal are repeated here (else Host would be "app": 403).
        location ~ ^/api/(runs|downloads)/[A-Za-z0-9._-]+/events$ {
            proxy_set_header Host $host:@LAN_PORT@;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header Forwarded "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
            proxy_pass http://app;
        }

        location / {
            proxy_pass http://app;
        }
    }
}
