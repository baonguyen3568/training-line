{
  "format": "vlm-workflow",
  "schema_version": 1,
  "name": "Node chia sẻ chưa xác minh (T5)",
  "nodes": [
    {
      "id": "model",
      "type": "model.hf_pick",
      "version": "1.0.0",
      "params": {
        "model": "nemotron-parse-v1.1"
      },
      "ui": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "data",
      "type": "data.hf_load",
      "version": "1.0.0",
      "params": {
        "repo": "naver-clova-ix/cord-v2"
      },
      "ui": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "split",
      "type": "data.split",
      "version": "1.0.0",
      "params": {
        "val_fraction": 0.1
      },
      "ui": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "boost",
      "type": "fastvision/turbo-lora.train",
      "version": "1.0.0",
      "params": {
        "gpu_boost": true
      },
      "ui": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "edges": [
    {
      "from": [
        "data",
        "dataset"
      ],
      "to": [
        "split",
        "dataset"
      ]
    },
    {
      "from": [
        "model",
        "model"
      ],
      "to": [
        "boost",
        "base_model"
      ]
    },
    {
      "from": [
        "split",
        "train"
      ],
      "to": [
        "boost",
        "dataset"
      ]
    }
  ]
}
